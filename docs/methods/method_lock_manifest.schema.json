{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gmnps.local/schemas/attribute-gmnps-method-lock-v1.json",
  "title": "Attribute-level GMNPS method lock manifest",
  "description": "Reproducibility contract for the frozen attribute-level GMNPS primary method.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_schema_version",
    "method_lock_schema_sha256",
    "method_version",
    "source_hashes",
    "fndds_releases",
    "fndds_registry_version",
    "release_registry_snapshot",
    "beta_fit_cohort",
    "calibration_fit_ids_sha256",
    "development_beta_sha256",
    "normalization_state_fingerprint",
    "scoring_beta_sha256",
    "person_meal_validation_config_sha256",
    "mapping_version",
    "implementation_source_sha256",
    "method_lock_gate_implementation_sha256",
    "fixed_parameters",
    "validation_embargo"
  ],
  "properties": {
    "manifest_schema_version": {
      "const": "attribute-gmnps-method-lock-v1"
    },
    "method_lock_schema_sha256": {
      "description": "Run-instance SHA-256 recomputed by the external gate from these schema bytes; it is deliberately not a const inside the schema.",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "method_version": {
      "const": "attribute-gmnps-v1"
    },
    "source_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "official_fcs",
        "food_metadata",
        "baseline_attribute_points",
        "food_exposures",
        "effective_attribute_weights",
        "input_manifest",
        "food_source_linkage"
      ],
      "properties": {
        "official_fcs": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "food_metadata": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "baseline_attribute_points": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "food_exposures": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "effective_attribute_weights": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "input_manifest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "food_source_linkage": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "fndds_releases": {
      "const": [
        "FNDDS 2001-2002",
        "FNDDS 2003-2004",
        "FNDDS 2005-2006",
        "FNDDS 2007-2008",
        "FNDDS 2009-2010",
        "FNDDS 2011-2012",
        "FNDDS 2013-2014",
        "FNDDS 2015-2016",
        "FNDDS 2017-2018"
      ]
    },
    "fndds_registry_version": {
      "const": "fcs2-fndds-release-registry-v1"
    },
    "release_registry_snapshot": {
      "description": "Run-level data-registry provenance, separate from the frozen implementation lock.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_sha256",
        "schema_version",
        "registry_version",
        "digest_algorithm",
        "canonical_release_set",
        "approved_entry"
      ],
      "properties": {
        "snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "schema_version": {"const": "fcs2-fndds-release-registry-schema-v1"},
        "registry_version": {"const": "fcs2-fndds-release-registry-v1"},
        "digest_algorithm": {"const": "sha256"},
        "canonical_release_set": {
          "const": [
            "FNDDS 2001-2002",
            "FNDDS 2003-2004",
            "FNDDS 2005-2006",
            "FNDDS 2007-2008",
            "FNDDS 2009-2010",
            "FNDDS 2011-2012",
            "FNDDS 2013-2014",
            "FNDDS 2015-2016",
            "FNDDS 2017-2018"
          ]
        },
        "approved_entry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bundle_id",
            "entry_sha256",
            "fndds_releases",
            "artifact_sha256",
            "food_source_linkage_sha256",
            "nutrient_units",
            "exposure_basis"
          ],
          "properties": {
            "bundle_id": {"type": "string", "minLength": 1},
            "entry_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "fndds_releases": {
              "const": [
                "FNDDS 2001-2002",
                "FNDDS 2003-2004",
                "FNDDS 2005-2006",
                "FNDDS 2007-2008",
                "FNDDS 2009-2010",
                "FNDDS 2011-2012",
                "FNDDS 2013-2014",
                "FNDDS 2015-2016",
                "FNDDS 2017-2018"
              ]
            },
            "artifact_sha256": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "official_fcs",
                "food_metadata",
                "baseline_attribute_points",
                "food_exposures",
                "effective_attribute_weights"
              ],
              "properties": {
                "official_fcs": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "food_metadata": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "baseline_attribute_points": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "food_exposures": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "effective_attribute_weights": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
            },
            "food_source_linkage_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "nutrient_units": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {"type": "string", "minLength": 1}
            },
            "exposure_basis": {"const": "per_100_kcal"}
          }
        }
      }
    },
    "beta_fit_cohort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cohort_id", "fit_n"],
      "properties": {
        "cohort_id": {"type": "string", "minLength": 1},
        "fit_n": {"type": "integer", "minimum": 1}
      }
    },
    "calibration_fit_ids_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "development_beta_sha256": {
      "description": "SHA-256 of the canonical development beta matrix bound into the frozen fit state.",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "normalization_state_fingerprint": {
      "description": "Content fingerprint of the complete frozen fit state produced from development beta only.",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "scoring_beta_sha256": {
      "description": "SHA-256 of the canonical held-out scoring beta matrix supplied by this run instance.",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "person_meal_validation_config_sha256": {
      "description": "SHA-256 of the canonical bytes of frozen person_meal_validation.yaml supplied by this run instance.",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "mapping_version": {
      "const": "expert_reviewed_attribute_mapping_v1"
    },
    "implementation_source_sha256": {
      "description": "Frozen implementation and configuration bytes used by this method version.",
      "const": {
        "code/src/gmnps/scoring/fcs2_attribute_rules.py": "8758d245d2e4d7d23a71829893ddfcc7e4b12b120bf8cc2e1c20d4e1c6efba14",
        "code/src/gmnps/scoring/fcs2_attribute_mapping.py": "d885be53736d020c6797b8b8f6d470c185ca0b1e13bf7b07752b32ec0de200d1",
        "code/src/gmnps/scoring/attribute_calibration.py": "2dcc803e46f07f2a1c7ca11e31bced942df84bd66496afabd61ec8b86e8585c6",
        "code/src/gmnps/scoring/attribute_recomposition.py": "806306099b1d398fce1777c3b5714e1465fcc5949c4cf9a8f6fc2d1b1bf3119e",
        "code/src/gmnps/scoring/attribute_gmnps.py": "b1ac1465f69f968232d1e9b07854a96a29675dbd6516c60a359df7868d83a728",
        "code/src/configs/attribute_gmnps.yaml": "37a46a0cb0d24da374698dd4f900946efb8f581f89d843c27e35ce54fb39d2f2",
        "code/src/scripts/run_attribute_gmnps.py": "3771af05eb598d59658e9edd3d9838a1260c9397df4b4af659c2d2404ed601ad"
      }
    },
    "method_lock_gate_implementation_sha256": {
      "description": "Run-instance SHA-256 of the Phase 2 method_lock_gate.py implementation, recomputed before outcomes and at the Task 3 entry.",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "fixed_parameters": {
      "const": {
        "baseline": "FoodCompass2.0",
        "primary_method": "attribute_recomposition",
        "beta_normalization_method": "median_mad_iqr_sd_v1",
        "beta_mad_normal_consistency": 1.4826,
        "beta_iqr_normal_consistency": 1.349,
        "beta_temperature": 2.0,
        "score_centering": "none",
        "beta_centering": "development_median",
        "attribute_response_temperature": 2.0,
        "attribute_point_mode": "primary",
        "attribute_point_fraction_cap": 0.2,
        "attribute_point_fraction_sensitivity": [0.1, 0.3],
        "final_cap_mode": "primary",
        "final_delta_cap": 12.0,
        "final_delta_cap_sensitivity": [8.0, 15.0],
        "carbohydrate_policy": "sensitivity_proxy_only",
        "clinical_experiment": false,
        "recomputed_domains": [
          "nutrient_ratios",
          "vitamins",
          "minerals",
          "specific_lipids",
          "fiber_and_protein",
          "phytochemicals"
        ],
        "recomposition_method": "native_domain_fixed_residual_v1",
        "mask_version": "expert_revised_v4_dual_channel",
        "nitrite_primary_rule": "footnote_50",
        "nitrite_sensitivity_rule": "table_25",
        "fcs_unscaled_min": -12.1,
        "fcs_unscaled_max": 35.0,
        "fcs_min": 1.0,
        "fcs_max": 100.0,
        "top_k_vitamins": 5,
        "top_k_minerals": 5,
        "top_k_specific_lipids": 3,
        "specific_lipids_domain_weight": 0.5,
        "phytochemicals_domain_weight": 0.5
      }
    },
    "validation_embargo": {
      "description": "True means validation data and outcomes remain unavailable for fitting, mapping, parameter choice, or method revision.",
      "const": true
    }
  }
}
